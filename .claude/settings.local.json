{
  "skipDangerousModePermissionPrompt": true,
  "sandbox": {
    "network": {
      "allowedDomains": ["discord.com"]
    }
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "WebFetch(*)",
      "Powershell",
      "Powershell(*)"
    ]
  }
}
